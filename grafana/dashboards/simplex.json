          "color": {
            "mode": "value"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "#73BF69",
                  "index": 0,
                  "text": "GREEN"
                },
                "1": {
                  "color": "#F2CC0C",
                  "index": 1,
                  "text": "YELLOW"
                },
                "2": {
                  "color": "#F2495C",
                  "index": 2,
                  "text": "RED"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
